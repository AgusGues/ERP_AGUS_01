<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5bbe99fb-04ca-4bfc-b5cf-61ca55bd222b</UserSecretsId>
    <!-- DockerDefaultTargetOS dihapus supaya build di Linux Railway tidak error -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Paket untuk koneksi SQL Server -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <!-- Paket Visual Studio khusus development dihapus -->
  </ItemGroup>

</Project>
